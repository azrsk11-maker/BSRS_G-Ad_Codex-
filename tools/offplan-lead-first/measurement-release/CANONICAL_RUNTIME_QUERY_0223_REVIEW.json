      "edits": [
        {
          "offset": 1065,
          "remove": 59,
          "lines": [
            "function measurement_runtime_query(array $params, string $raw_query): ?array {"
          ]
        },
        {
          "offset": 1730,
          "remove": 21,
          "lines": [
            "    // PHP's parsed query silently collapses repeated fields. Match the raw\n",
            "    // representation to the validated intent before acquiring a runtime lease.\n",
            "    if (strlen($raw_query) > 4096) return null;\n",
            "    $fields = explode('&', $raw_query);\n",
            "    if (count($fields) !== count($params)) return null;\n",
            "    $seen = [];\n",
            "    foreach ($fields as $field) {\n",
            "        $pair = explode('=', $field, 2);\n",
            "        if (count($pair) !== 2) return null;\n",
            "        [$key, $encoded] = $pair;\n",
            "        if (isset($seen[$key]) || !array_key_exists($key, $params) || rawurldecode($encoded) !== $params[$key]) return null;\n",
            "        $seen[$key] = true;\n",
            "    }\n",
            "    return $params;\n",
            "}"
          ]
        },
        {
          "offset": 7614,
          "remove": 70,
          "lines": [
            "    $params = measurement_runtime_query($request->get_query_params(), (string) ($_SERVER['QUERY_STRING'] ?? ''));"
          ]
        }
      ]
    }
