      "edits": [
        {
          "offset": 134,
          "remove": 0,
          "lines": [
            "\n",
            "const OFFPLAN_COUNTRY_RECOVERY_NOTICES = [\n",
            "    '/off-plan-dubai-en-de/' => 'bsre-en-de-offplan-ads-review-v1',\n",
            "    '/off-plan-dubai-en-fr/' => 'bsre-en-fr-offplan-ads-review-v1',\n",
            "    '/off-plan-dubai-en-tw/' => 'bsre-en-tw-offplan-ads-review-v1',\n",
            "];\n"
          ]
        },
        {
          "offset": 2294,
          "remove": 0,
          "lines": [
            "function offplan_country_recover(string $raw, string $request_id, string $decision, string $notice): \\WP_REST_Response {\n",
            "    try {\n",
            "        $store = consent_repository();\n",
            "        $row = $store->findCapture(strtolower($request_id));\n",
            "        if (!$row || $row['notice_version'] !== $notice\n",
            "            || !hash_equals($row['fingerprint'], hash('sha256', $raw)) || !hash_equals($row['decision_version'], $decision)\n",
            "            || !in_array($row['state'], ['STAGED', 'ACCEPTED'], true)\n",
            "            || (int) $row['known'] !== 1 || (int) $row['ad_measurement'] !== 1 || (int) $row['eligible'] !== 1\n",
            "            || (int) $row['analytics'] !== 0 || (int) $row['personalization'] !== 0\n",
            "            || (int) $row['original_revision'] < 1 || !preg_match('/^[a-f0-9]{64}$/D', $row['subject_key'])\n",
            "            || $row['click_capture_state'] !== 'NOT_PERMITTED') return reply(409, 'REQUEST_ID_CONFLICT');\n",
            "        if ($row['state'] === 'ACCEPTED') {\n",
            "            if (!consent_valid_receipt_id($row['lead_id'], 'BSRE-')\n",
            "                || !consent_valid_receipt_id($row['event_id'], 'evt_')) throw new \\RuntimeException();\n",
            "            // Reuse the locally linked receipt without forwarding the body again.\n",
            "            if ((int) $row['delivery_pending'] !== 0) {\n",
            "                $store->link($row['request_id'], $row['fingerprint'], $row['lead_id'], $row['event_id']);\n",
            "            }\n",
            "            return response(200, ['accepted' => true, 'lead_id' => $row['lead_id'], 'event_id' => $row['event_id'],\n",
            "                'measurement' => consent_denied_snapshot(), 'measurement_eligible' => false]);\n",
            "        }\n",
            "    } catch (\\Throwable $e) { return reply(503, 'ACCEPTANCE_UNCERTAIN_RETRY_SAME_ID', true); }\n",
            "\n",
            "    // Preserve the original capture. A successful receiver response must link\n",
            "    // to it before acknowledging recovery, with every optional purpose denied.\n",
            "    $capture = ['recorded' => true, 'row' => $row, 'repository' => $store];\n",
            "    return relay_accepted_enquiry($raw, $capture, true, static function (array $handle, array $receipt): array {\n",
            "        if (!consent_valid_receipt_id($receipt['lead_id'] ?? null, 'BSRE-')\n",
            "            || !consent_valid_receipt_id($receipt['event_id'] ?? null, 'evt_')) throw new \\RuntimeException();\n",
            "        $row = $handle['row'];\n",
            "        $handle['repository']->link($row['request_id'], $row['fingerprint'], $receipt['lead_id'], $receipt['event_id']);\n",
            "        return consent_denied_snapshot();\n",
            "    });\n",
            "}\n",
            "\n"
          ]
        },
        {
          "offset": 3368,
          "remove": 192,
          "lines": [
            "    if (($payload->attribution->first ?? null) !== null\n"
          ]
        },
        {
          "offset": 3659,
          "remove": 0,
          "lines": [
            "    $notice = OFFPLAN_COUNTRY_RECOVERY_NOTICES[$path] ?? null;\n",
            "    if (!in_array($decision, ['', 'none'], true)) {\n",
            "        if (!preg_match('/^[a-f0-9]{32}$/D', $decision)) return reply(400, 'VALIDATION_FAILED');\n",
            "        if ($notice !== null) {\n",
            "            // The existing browser rotates the request ID after a validation error.\n",
            "            if ($request->get_header('x-bsre-consent-retry') !== '1') return reply(409, 'REQUEST_ID_CONFLICT');\n",
            "            return offplan_country_recover($raw, $payload->request_id, $decision, $notice);\n",
            "        }\n",
            "        if (!offplan_country_ad_binding_id($path)) return reply(400, 'VALIDATION_FAILED');\n",
            "    }\n"
          ]
        }
