            "        return $this->writeCapture($capture, false);\n",
            "    }\n",
            "    public function stageCurrentAdvertisingChoice(array $capture): array {\n",
            "        return $this->writeCapture($capture, true);\n",
            "    }\n",
            "    private function writeCapture(array $capture, bool $lock_choice): array {\n",
            "        return $this->transaction(function () use ($capture, $lock_choice) {\n",
            "            if ($lock_choice) {\n",
            "                $subject = $capture['subject_key'];\n",
            "                $revision = (int) $capture['original_revision'];\n",
            "                $current = $this->row($this->db->prepare(\"SELECT * FROM {$this->state} WHERE subject_key=%s FOR UPDATE\", $subject));\n",
            "                if (!$current || (int) $current['revision'] !== $revision || (int) $current['ad_measurement'] !== 1\n",
            "                    || (int) $current['analytics'] !== 0 || (int) $current['personalization'] !== 0 || (int) $current['uncertain'] !== 0\n",
            "                    || $current['notice_version'] !== $capture['notice_version'] || !hash_equals($current['receipt'], $capture['decision_version'])\n",
            "                    || (int) $current['expires_at'] !== (int) $capture['preference_expires_at'] || (int) $current['expires_at'] <= time()) {\n",
            "                    throw new \\RuntimeException('Consent choice no longer current.');\n",
            "                }\n",
            "                $original = $this->row($this->db->prepare(\"SELECT receipt FROM {$this->history} WHERE subject_key=%s AND revision=%d FOR UPDATE\", $subject, $revision));\n",
            "                if (!$original || !hash_equals($original['receipt'], $capture['decision_version'])) {\n",
            "                    throw new \\RuntimeException('Consent evidence retired.');\n",
            "                }\n",
            "            }\n"
          ]
        }
      ]
    },
